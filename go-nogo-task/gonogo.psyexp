  <Routines>
    <Routine name="experimentalTrial">
      <RoutineSettingsComponent name="experimentalTrial" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="experimentalTrial" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="expTrial_addData" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;myExp.trial&quot;, sequenceDataset.trial[experimentalBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myExp.letter&quot;, sequenceDataset.letter[experimentalBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myExp.nogo_letter&quot;, sequenceDataset.nogo_letter[experimentalBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myExp.nogo&quot;, sequenceDataset.nogo[experimentalBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myExp.expectedResponse&quot;, sequenceDataset.expectedResponse[experimentalBlock.thisN]);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# add data about the sequence&amp;#10;thisExp.addData('myExp.trial',            sequenceDataset.trial[experimentalBlock.thisN])&amp;#10;thisExp.addData('myExp.letter',           sequenceDataset.letter[experimentalBlock.thisN])&amp;#10;thisExp.addData('myExp.nogo_letter',           sequenceDataset.nogo_letter[experimentalBlock.thisN])&amp;#10;thisExp.addData('myExp.nogo',      sequenceDataset.nogo[experimentalBlock.thisN])&amp;#10;thisExp.addData('myExp.expectedResponse', sequenceDataset.expectedResponse[experimentalBlock.thisN])&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# nogo_letter&amp;#10;sequenceDataset.nogo_letter[experimentalBlock.thisN] = nogo_data['nogo_letter'].iloc[AllExperimentalBlocks.thisN]&amp;#10;thisExp.addData('myExp.nogo_letter', sequenceDataset.nogo_letter[experimentalBlock.thisN])&amp;#10;&amp;#10;# nogo&amp;#10;sequenceDataset.nogo[experimentalBlock.thisN] = int(sequenceDataset.letter[experimentalBlock.thisN] == nogo_data['nogo_letter'].iloc[AllExperimentalBlocks.thisN])&amp;#10;thisExp.addData('myExp.nogo', sequenceDataset.nogo[experimentalBlock.thisN])" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="sequenceDataset.nogo_letter[experimentalBlock.thisN] = nogo_data[&quot;nogo_letter&quot;].iloc[AllExperimentalBlocks.thisN];&amp;#10;psychoJS.experiment.addData(&quot;myExp.nogo_letter&quot;, sequenceDataset.nogo_letter[experimentalBlock.thisN]);&amp;#10;sequenceDataset.nogo[experimentalBlock.thisN] = Number.parseInt((sequenceDataset.letter[experimentalBlock.thisN] === nogo_data[&quot;nogo_letter&quot;].iloc[AllExperimentalBlocks.thisN]));&amp;#10;psychoJS.experiment.addData(&quot;myExp.nogo&quot;, sequenceDataset.nogo[experimentalBlock.thisN]);&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((sequenceDataset.nogo[experimentalBlock.thisN] === 1)) {&amp;#10;    sequenceDataset.expectedResponse[experimentalBlock.thisN] = &quot;None&quot;;&amp;#10;} else {&amp;#10;    sequenceDataset.expectedResponse[experimentalBlock.thisN] = &quot;space&quot;;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myExp.expectedResponse&quot;, sequenceDataset.expectedResponse[experimentalBlock.thisN]);&amp;#10;if (expTrial_key.keys) {&amp;#10;    sequenceDataset.observedResponse[experimentalBlock.thisN] = expTrial_key.keys;&amp;#10;} else {&amp;#10;    sequenceDataset.observedResponse[experimentalBlock.thisN] = &quot;None&quot;;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myExp.observedResponse&quot;, sequenceDataset.observedResponse[experimentalBlock.thisN]);&amp;#10;if ((sequenceDataset.nogo[experimentalBlock.thisN] === 1)) {&amp;#10;    sequenceDataset.Accuracy[experimentalBlock.thisN] = Number.parseInt((sequenceDataset.observedResponse[experimentalBlock.thisN] === &quot;None&quot;));&amp;#10;} else {&amp;#10;    sequenceDataset.Accuracy[experimentalBlock.thisN] = Number.parseInt((sequenceDataset.observedResponse[experimentalBlock.thisN] === &quot;space&quot;));&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myExp.Accuracy&quot;, sequenceDataset.Accuracy[experimentalBlock.thisN]);&amp;#10;if ((sequenceDataset.nogo[experimentalBlock.thisN] === 1)) {&amp;#10;    sequenceDataset.AccuracyNogo[experimentalBlock.thisN] = Number.parseInt((sequenceDataset.observedResponse[experimentalBlock.thisN] === &quot;None&quot;));&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myExp.AccuracyNogo&quot;, sequenceDataset.AccuracyNogo[experimentalBlock.thisN]);&amp;#10;if (expTrial_key.keys) {&amp;#10;    sequenceDataset.RT_allTrials[experimentalBlock.thisN] = expTrial_key.rt;&amp;#10;} else {&amp;#10;    sequenceDataset.RT_allTrials[experimentalBlock.thisN] = null;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myExp.RT_allTrials&quot;, sequenceDataset.RT_allTrials[experimentalBlock.thisN]);&amp;#10;if (((expTrial_key.keys &amp;&amp; (sequenceDataset.Accuracy[experimentalBlock.thisN] === 1)) &amp;&amp; (sequenceDataset.nogo[experimentalBlock.thisN] !== 1))) {&amp;#10;    sequenceDataset.RT_correctTrials[experimentalBlock.thisN] = expTrial_key.rt;&amp;#10;} else {&amp;#10;    sequenceDataset.RT_correctTrials[experimentalBlock.thisN] = null;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myExp.RT_correctTrials&quot;, sequenceDataset.RT_correctTrials[experimentalBlock.thisN]);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# expected key&amp;#10;if sequenceDataset.nogo[experimentalBlock.thisN] == 1:&amp;#10;    sequenceDataset.expectedResponse[experimentalBlock.thisN]         = &quot;None&quot;&amp;#10;else:&amp;#10;    sequenceDataset.expectedResponse[experimentalBlock.thisN]         = &quot;space&quot;&amp;#10;thisExp.addData('myExp.expectedResponse',         sequenceDataset.expectedResponse[experimentalBlock.thisN])&amp;#10;&amp;#10;# observed response&amp;#10;if expTrial_key.keys:&amp;#10;    sequenceDataset.observedResponse[experimentalBlock.thisN]        = expTrial_key.keys&amp;#10;else:&amp;#10;    sequenceDataset.observedResponse[experimentalBlock.thisN]        = 'None'&amp;#10;thisExp.addData('myExp.observedResponse', sequenceDataset.observedResponse[experimentalBlock.thisN])&amp;#10;&amp;#10;# Accuracy&amp;#10;if sequenceDataset.nogo[experimentalBlock.thisN] == 1:&amp;#10;    sequenceDataset.Accuracy[experimentalBlock.thisN]             = int(sequenceDataset.observedResponse[experimentalBlock.thisN] == &quot;None&quot;) &amp;#10;else:&amp;#10;    sequenceDataset.Accuracy[experimentalBlock.thisN]             = int(sequenceDataset.observedResponse[experimentalBlock.thisN] == &quot;space&quot;) &amp;#10;thisExp.addData('myExp.Accuracy',         sequenceDataset.Accuracy[experimentalBlock.thisN])&amp;#10;&amp;#10;# AccuracyNogo&amp;#10;if sequenceDataset.nogo[experimentalBlock.thisN] == 1:&amp;#10;    sequenceDataset.AccuracyNogo[experimentalBlock.thisN]         = int(sequenceDataset.observedResponse[experimentalBlock.thisN] == &quot;None&quot;) &amp;#10;thisExp.addData('myExp.AccuracyNogo',         sequenceDataset.AccuracyNogo[experimentalBlock.thisN])&amp;#10;&amp;#10;# RT all trials&amp;#10;if expTrial_key.keys:&amp;#10;    sequenceDataset.RT_allTrials[experimentalBlock.thisN]         = expTrial_key.rt&amp;#10;else:&amp;#10;    sequenceDataset.RT_allTrials[experimentalBlock.thisN]         = None&amp;#10;thisExp.addData('myExp.RT_allTrials',     sequenceDataset.RT_allTrials[experimentalBlock.thisN])&amp;#10;    &amp;#10;# RT correct trials&amp;#10;if expTrial_key.keys and sequenceDataset.Accuracy[experimentalBlock.thisN] == 1 and sequenceDataset.nogo[experimentalBlock.thisN] != 1:&amp;#10;    sequenceDataset.RT_correctTrials[experimentalBlock.thisN]     = expTrial_key.rt&amp;#10;else:&amp;#10;    sequenceDataset.RT_correctTrials[experimentalBlock.thisN]     = None&amp;#10;thisExp.addData('myExp.RT_correctTrials',     sequenceDataset.RT_correctTrials[experimentalBlock.thisN])&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="expTrial_addData" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="expTrial_cross" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="None" valType="str" updates="constant" name="flip"/>
        <Param val="Open Sans" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="0.05" valType="num" updates="constant" name="letterHeight"/>
        <Param val="expTrial_cross" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, -0.0125)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="1" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="+" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <TextComponent name="expTrial_stimuli" plugin="None">
        <Param val="-1.0000, -1.0000, -1.0000" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="None" valType="str" updates="constant" name="flip"/>
        <Param val="Open Sans" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="0.3" valType="num" updates="constant" name="letterHeight"/>
        <Param val="expTrial_stimuli" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="1.0" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="$sequenceDataset.letter[experimentalBlock.thisN]" valType="str" updates="set every repeat" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <KeyboardComponent name="expTrial_key" plugin="None">
        <Param val="'space', None" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="$sequenceDataset.expectedResponse[experimentalBlock.thisN]" valType="str" updates="constant" name="correctAns"/>
        <Param val="" valType="str" updates="None" name="deviceLabel"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="True" valType="bool" updates="constant" name="discard previous"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="bool" updates="constant" name="forceEndRoutine"/>
        <Param val="expTrial_key" valType="code" updates="None" name="name"/>
        <Param val="press" valType="str" updates="constant" name="registerOn"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="1.0" valType="code" updates="constant" name="stopVal"/>
        <Param val="first key" valType="str" updates="constant" name="store"/>
        <Param val="True" valType="bool" updates="constant" name="storeCorrect"/>
        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
      </KeyboardComponent>
      <CodeComponent name="expTrial_serialCOM" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# initialize variables controlling whether the stimulus and response triggers have been sent for this trial&amp;#10;stimulusPulse_sent = False&amp;#10;responsePulse_sent = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# communicate with the serial port&amp;#10;if doYouWantCOM:&amp;#10;   &amp;#10;    # send stimulus pulse and record at what time it is sent&amp;#10;    if expTrial_stimuli.status == STARTED and not stimulusPulse_sent:&amp;#10;        # decide which marker to send&amp;#10;        if sequenceDataset.nogo[experimentalBlock.thisN]:&amp;#10;            stimmarker2send = marker_stimulusOnset_nogo&amp;#10;        else:&amp;#10;            stimmarker2send = marker_stimulusOnset_go&amp;#10;        # send marker&amp;#10;        win.callOnFlip(port.write, [stimmarker2send])&amp;#10;        stimulusPulse_startTime = core.monotonicClock.getTime()&amp;#10;        stimulusPulse_sent = True&amp;#10;        stimulusPulse_terminated = False&amp;#10;    # forcing termination of a stimulus pulse if it lasts at least 20 ms&amp;#10;    if stimulusPulse_sent and not stimulusPulse_terminated:  &amp;#10;        if core.monotonicClock.getTime() - stimulusPulse_startTime &gt;= 0.020:&amp;#10;            win.callOnFlip(port.write, [0])&amp;#10;            stimulusPulse_terminated = True&amp;#10;    &amp;#10;&amp;#10;    # send a response pulse and record at what time it is sent&amp;#10;    if len(expTrial_key.keys)&gt;0 and not responsePulse_sent:&amp;#10;        # decide which marker to send&amp;#10;        if expTrial_key.keys == 'space':&amp;#10;            if sequenceDataset.nogo[experimentalBlock.thisN]:&amp;#10;                respmarker2send = marker_response_falsePositive&amp;#10;            else:&amp;#10;                respmarker2send = marker_response_truePositive&amp;#10;        # send marker&amp;#10;        win.callOnFlip(port.write, [respmarker2send])&amp;#10;        responsePulse_startTime = core.monotonicClock.getTime()&amp;#10;        responsePulse_sent = True&amp;#10;        responsePulse_terminated = False&amp;#10;    # forcing termination of a response pulse if it lasts at least 20 ms&amp;#10;    if responsePulse_sent and not responsePulse_terminated:  &amp;#10;        if core.monotonicClock.getTime() - responsePulse_startTime &gt;= 0.020:&amp;#10;            win.callOnFlip(port.write, [0])&amp;#10;            responsePulse_terminated = True&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# add timing of triggers&amp;#10;if stimulusPulse_sent:&amp;#10;    thisExp.addData('myExp.stimulusPulse_startTime', stimulusPulse_startTime)&amp;#10;    thisExp.addData('myExp.stimulusPulse_marker', stimmarker2send)&amp;#10;if responsePulse_sent:&amp;#10;    thisExp.addData('myExp.responsePulse_startTime', responsePulse_startTime)&amp;#10;    thisExp.addData('myExp.responsePulse_marker', respmarker2send)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="expTrial_serialCOM" valType="code" updates="None" name="name"/>
      </CodeComponent>
