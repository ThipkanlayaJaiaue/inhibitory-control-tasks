        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="expStimuliSequenceGeneration" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="expStimuli_sequenceGeneration" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="import numpy as np&amp;#10;import pandas as pd&amp;#10;&amp;#10;# set up parameters&amp;#10;trialAll_num = 60&amp;#10;block = 1&amp;#10;&amp;#10;# create trial column&amp;#10;trial = 1 + np.arange(0, trialAll_num)&amp;#10;&amp;#10;# create a pool of letters&amp;#10;pool = [&quot;A&quot;, &quot;B&quot;, &quot;C&quot;, &quot;D&quot;, &quot;E&quot;]&amp;#10;&amp;#10;# create empty array for storing letter&amp;#10;letter = np.empty(trialAll_num, dtype=&quot;&lt;U1&quot;)&amp;#10;&amp;#10;# fill letter column&amp;#10;for trialIdx in range(block):&amp;#10;    # add 12 repeated times of each letter&amp;#10;    block_letters = np.repeat(pool, trialAll_num // len(pool))&amp;#10;    np.random.shuffle(block_letters)  # shuffle letters within the block&amp;#10;&amp;#10;    # assign letters to the trial sequence&amp;#10;    letter[trialIdx * trialAll_num:(trialIdx + 1) * trialAll_num] = block_letters&amp;#10;&amp;#10;# create an empty array to store blank duration&amp;#10;blank_duration = np.empty(trialAll_num, dtype=float)&amp;#10;&amp;#10;# create blank duration options&amp;#10;duration_pool = np.array([0.45, 0.5, 0.55, 0.6, 0.65, 0.7] * 10)&amp;#10;# shuffle the duration pool randomly&amp;#10;np.random.shuffle(duration_pool)&amp;#10;# assign the shuffled pool to blank_duration&amp;#10;blank_duration = duration_pool&amp;#10;&amp;#10;# create dataset&amp;#10;sequenceDataset = pd.DataFrame({&amp;#10;    'trial': trial,&amp;#10;    'letter': letter,&amp;#10;    'nogo_letter': np.nan,&amp;#10;    'nogo': np.nan,&amp;#10;    'expectedResponse': np.nan,&amp;#10;    'observedResponse': np.nan,&amp;#10;    'Accuracy': np.nan,&amp;#10;    'AccuracyNogo': np.nan,&amp;#10;    'RT_allTrials': np.nan,&amp;#10;    'RT_correctTrials': np.nan,&amp;#10;    'blank_duration': blank_duration,&amp;#10;    'trialDuration': np.nan,&amp;#10;})&amp;#10;&amp;#10;sequenceDataset" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="expStimuli_sequenceGeneration" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="expLetterSequenceGeneration">
      <RoutineSettingsComponent name="expLetterSequenceGeneration" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="expLetterSequenceGeneration" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="expLetter_sequenceGeneration" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="import * as random from 'random';&amp;#10;import * as pd from 'pandas';&amp;#10;import * as np from 'numpy';&amp;#10;nogo_pool = [&quot;A&quot;, &quot;B&quot;, &quot;C&quot;, &quot;D&quot;, &quot;E&quot;];&amp;#10;Math.random.shuffle(nogo_pool);&amp;#10;block_num = nogo_pool.length;&amp;#10;nogoBlock_num = np.arange(1, (block_num + 1));&amp;#10;nogo_data = new pd.DataFrame({&quot;nogoBlock_num&quot;: nogoBlock_num, &quot;nogo_letter&quot;: nogo_pool});&amp;#10;nogo_data;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="import random&amp;#10;import pandas as pd&amp;#10;import numpy as np  &amp;#10;&amp;#10;# define the pool of letters&amp;#10;nogo_pool = ['A', 'B', 'C', 'D', 'E']&amp;#10;&amp;#10;# randomly shuffle the pool&amp;#10;random.shuffle(nogo_pool)&amp;#10;&amp;#10;# define the number of blocks&amp;#10;block_num = len(nogo_pool)&amp;#10;&amp;#10;# create block number column&amp;#10;nogoBlock_num = np.arange(1, block_num + 1)&amp;#10;&amp;#10;# create a DataFrame from the shuffled pool&amp;#10;nogo_data = pd.DataFrame({&amp;#10;    'nogoBlock_num': nogoBlock_num,&amp;#10;    'nogo_letter': nogo_pool&amp;#10;    &amp;#10;})&amp;#10;&amp;#10;nogo_data" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="expLetter_sequenceGeneration" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="COMsettings">
      <RoutineSettingsComponent name="COMsettings" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="sets some info for the COM communication" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="COMsettings" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="import serial&amp;#10;&amp;#10;# connect to serial COM port&amp;#10;# True = yes for the experiment flow and the serial port communication&amp;#10;# False = no for the experiment flow only&amp;#10;# The COM port needs to be updated based on the specific device connection&amp;#10;doYouWantCOM = False&amp;#10;if doYouWantCOM:&amp;#10;    port = serial.Serial(port='COM7', baudrate=2000000)&amp;#10;    port.timeout = 1               # timeout 1 second (give 1 second to the board to initialize port)&amp;#10;&amp;#10;&amp;#10;marker_stimulusOnset_go       = 1&amp;#10;marker_stimulusOnset_nogo     = 2&amp;#10;marker_response_truePositive  = 16 # response in a go trial&amp;#10;marker_response_falsePositive = 32 # response in a nogo trial" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
  </Routines>
  <Flow>
    <Routine name="COMsettings"/>
