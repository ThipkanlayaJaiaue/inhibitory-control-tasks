      <CodeComponent name="practFB_code2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# number of trials&amp;#10;Practice_allTrials_num = len(sequenceDataset.Accuracy) &amp;#10;Practice_NogoTrials_num = np.sum(sequenceDataset.nogo) &amp;#10;&amp;#10;# number of trials with correct answer&amp;#10;Practice_correctTrials_num = np.sum(sequenceDataset.Accuracy)&amp;#10;Practice_correctNogoTrials_num = np.sum(sequenceDataset.AccuracyNogo)&amp;#10;&amp;#10;# percentage of trials with correct answer&amp;#10;Practice_correctTrials_pct= 100*Practice_correctTrials_num/ Practice_allTrials_num&amp;#10;Practice_correctNogoTrials_pct= 100*Practice_correctNogoTrials_num/ Practice_NogoTrials_num&amp;#10;&amp;#10;# Mdn RT for all responses&amp;#10;Practice_allTrials_MdnRT = np.median(sequenceDataset.RT_allTrials)&amp;#10;&amp;#10;# Mdn RT for only correct responses&amp;#10;if Practice_correctTrials_num&gt; 0:&amp;#10;    Practice_correctTrials_MdnRT = np.nanmedian(sequenceDataset.RT_correctTrials)&amp;#10;&amp;#10;# 3rd quartile (i.e., 75th percentile) RT for only correct responses&amp;#10;if Practice_correctTrials_num&gt; 0:&amp;#10;    Practice_correctTrials_3qrtRT = np.nanpercentile(sequenceDataset.RT_correctTrials, 75)&amp;#10;&amp;#10;&amp;#10;# message for feedback&amp;#10;if Practice_correctTrials_num&gt; 0:&amp;#10;    msg =  &quot;%i of %i correct responses \n%.2f%% correct overall \n%i of %i correct stops \n%.2f%% correct stops \nMdn RT = %.2f s &quot; % (Practice_correctTrials_num, Practice_allTrials_num, Practice_correctTrials_pct, Practice_correctNogoTrials_num, Practice_NogoTrials_num, Practice_correctNogoTrials_pct, Practice_correctTrials_MdnRT)&amp;#10;&amp;#10;else:&amp;#10;    msg =  &quot;%i of %i correct responses \n%.2f%% correct overall \n%i of %i correct stops \n%.2f%% correct stops&quot; % (Practice_correctTrials_num, Practice_allTrials_num, Practice_correctTrials_pct, Practice_correctNogoTrials_num, Practice_NogoTrials_num, Practice_correctNogoTrials_pct)&amp;#10;&amp;#10;&amp;#10;# color of feedback&amp;#10;if Practice_correctTrials_pct&gt;=70 and Practice_correctNogoTrials_pct &gt;= 70:&amp;#10;    fb_col = 'green'     # if accuracy is at least the value above&amp;#10;else:&amp;#10;    fb_col = 'red'" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if Practice_correctTrials_pct&gt;=70 and Practice_correctNogoTrials_pct &gt;= 70:&amp;#10;    practiceRepetition.finished = True" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="practFB_code2" valType="code" updates="None" name="name"/>
      </CodeComponent>
